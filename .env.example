# =====================================================================
# ROCK CORPORATION - Variables de Entorno
# =====================================================================
# Para PRODUCCIÓN en Render: añade DATABASE_URL en el panel de Render
# (se genera automáticamente al crear una PostgreSQL Database en Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Para DESARROLLO LOCAL con MySQL (XAMPP):
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rock_corporation
MYSQL_PORT=3306

# Credenciales del Administrador inicial (se crean en el primer arranque)
ADMIN_EMAIL=admin@rock.com
ADMIN_PASSWORD=Admin12345
